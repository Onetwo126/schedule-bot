[Unit]
Description=Schedule Telegram Bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
User=reventonrap
WorkingDirectory=/home/reventonrap/schedule-bot
Environment=NODE_ENV=production
Environment=USERS_FILE=/var/lib/schedule-bot/users.json
ExecStartPre=/usr/bin/test -f .env
ExecStartPre=/usr/bin/test -f credentials/service-account.json
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5
StateDirectory=schedule-bot
StateDirectoryMode=0700
UMask=0077
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
